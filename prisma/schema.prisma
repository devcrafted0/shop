generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/* PRODUCTS :- 

PRODUCT (PAINT , CEMENET )
PRODUCT TYPE (ENAMEL , WEATHER SHEAT , BLACK CEMENT (WHITE CEMENT))
PRODUCT COMPANY (MARVEL , MAPLE LEAF)
PRODUCT NAME (Eg:- Black , White)

PRODUCT Code ( COLOR CODE :- 111 ,  99999)
PRODUCT AMOUNT (1)
PRODUCT SIZE (TINLET , QUARTER , GALLON , DRUM , FULL)

*/

model Product {
  id         Int      @id @default(autoincrement())

  product    String
  type       String
  company    String
  name       String
  code       String  
  amount     Int      @default(0)
  size       ProductSize @default(FULL)
  actualPrice Float
  alertValue Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CustomProduct {
  id         Int      @id @default(autoincrement())
  name String
}

model ProductType {
  id         Int      @id @default(autoincrement())
  name String
}

model ProductCompany {
  id         Int      @id @default(autoincrement())
  name String
}

enum ProductSize {
  TINLET
  QUARTER
  GALLON
  DRUM
  FULL
}

model Invoice {
  id          Int      @id @default(autoincrement())
  description String
  products    Json
  sellPrice   Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CompanyPayment {
  id          Int      @id @default(autoincrement())
  name        String
  day         String
  credits     Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum CreditTransactionType {
  ADD
  REMOVE
}

model CompanyPaymentHistory {
  id              Int      @id @default(autoincrement())
  companyPaymentName  String
  description String?
  credits         Int
  beforeCredits   Int
  afterCredits    Int
  transactionType     CreditTransactionType

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}