generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Paint {
  id          Int      @id @default(autoincrement())

  name        String
  company     String
  color       String
  colorCode   String   @unique

  quarter     Int      @default(0)
  gallon      Int      @default(0)
  small       Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}